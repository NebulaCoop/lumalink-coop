{
  "authors": [
    "Nebula examples"
  ],
  "description": "A new power-up in Good Egg: a flower to pick up, a glow, its own sounds, and a spin that burns every enemy near.",
  "format": 1,
  "game": "RMG",
  "id": "gold-flower",
  "layers": [
    {
      "path": "layers/base",
      "player_animations": [
        {
          "blend_frames": 3,
          "file": "FireSpin",
          "name": "GoldFlowerSpin",
          "rate": 1.5
        }
      ]
    }
  ],
  "name": "The Gold Flower",
  "options": [
    {
      "choices": [
        {
          "id": "no",
          "name": "No"
        },
        {
          "id": "yes",
          "name": "Yes"
        }
      ],
      "default": "no",
      "description": "Every stage starts with the Gold Flower.",
      "id": "start",
      "name": "Start with it"
    }
  ],
  "plugins": [
    {
      "api": 2,
      "binaries": {
        "android-arm64": "plugins/gold-flower-android-arm64.so",
        "android-x64": "plugins/gold-flower-android-x64.so",
        "linux-arm64": "plugins/gold-flower-linux-arm64.so",
        "linux-x64": "plugins/gold-flower-linux-x64.so",
        "macos-arm64": "plugins/gold-flower-macos-arm64.dylib",
        "macos-x64": "plugins/gold-flower-macos-x64.dylib",
        "windows-arm64": "plugins/gold-flower-windows-arm64.dll",
        "windows-x64": "plugins/gold-flower-windows-x64.dll"
      }
    }
  ],
  "requires": [
    "player-animations"
  ],
  "version": "1.0.0"
}
