        "linux-x64": "plugins/gecko-mario-size-linux-x64.so",
        "macos-arm64": "plugins/gecko-mario-size-macos-arm64.dylib",
        "macos-x64": "plugins/gecko-mario-size-macos-x64.dylib",
        "windows-arm64": "plugins/gecko-mario-size-windows-arm64.dll",
        "windows-x64": "plugins/gecko-mario-size-windows-x64.dll"
      }
    }
  ],
  "version": "1.0.0"
