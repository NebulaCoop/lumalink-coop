              "type": "object",
              "additionalProperties": false,
              "required": [
                "n"
              ],
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Form"
          ],
          "properties": {
            "Form": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
