{
  "$comment": "kit/shop/<id>.json (lumakit data version 1). A shop of the mod, opened by code with kit.shop.find(id) and kit.shop.open. The keeper is an object of the stage and is given in code. `gives` is kit.item.Gives as json writes an enum's case; its cases grow with kit.item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "wares"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "currency": {
      "enum": [
        "Coins",
        "StarBits"
      ],
      "default": "Coins"
    },
    "wares": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "price",
          "gives"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "gives": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "Coins"
                ],
                "properties": {
                  "Coins": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "n"
                    ],
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "StarBits"
                ],
                "properties": {
                  "StarBits": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "n"
                    ],
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "Lives"
                ],
                "properties": {
                  "Lives": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "n"
                    ],
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "Health"
                ],
                "properties": {
                  "Health": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "n"
                    ],
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "Carry"
                ],
                "properties": {
                  "Carry": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "n"
                    ],
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "Form"
                ],
                "properties": {
                  "Form": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    }
                  }
                }
              }
            ]
          },
          "stock": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9999,
            "default": null
          }
        }
      }
    }
  }
}
